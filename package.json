{
  "name": "nextjs-fastapi-supabase-template",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack template featuring Next.js App Router (frontend + backend API), Supabase DB & Storage, and Python FastAPI AI backend.",
  "scripts": {
    "dev": "concurrently -n \"NEXT,FASTAPI\" -c \"magenta,cyan\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:agentic": "cd Agentic && .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:backend": "npm run dev:agentic",
    "dev:worker": "cd Agentic && .\\.venv\\Scripts\\python.exe -m app.assessment.worker",
    "test:agentic": "cd Agentic && .\\.venv\\Scripts\\python.exe -m pytest -q",
    "test:backend": "npm run test:agentic",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../Agentic && .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
