FASTAPI_BASE_URL=http://127.0.0.1:8000
# On the Next.js host: FASTAPI_BASE_URL=https://your-python-service.example.com
ASSESSMENT_STORAGE_BUCKET=teso-assessments
# Same secret as Agentic/.env. Never expose it with NEXT_PUBLIC_.
ASSESSMENT_BRIDGE_SECRET=replace-with-the-same-random-server-secret
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-cookie-secret-at-least-32-characters
# Explicit local development mode; forcibly disabled in production builds.
TESO_DEMO_MODE=true

# Server-only Neon connection: required for the team authentication roles/courses.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/neondb?sslmode=require
ADMIN_EMAILS=
