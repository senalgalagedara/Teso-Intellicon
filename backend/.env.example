# FastAPI AI Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Revision Engine (Neon PostgreSQL connection)
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>/neondb?sslmode=require
ENGINE_API_KEY=dev-secret-change-me

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=app-storage

# AI Provider API Keys (Fill with your key: Gemini or OpenAI or Anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default AI Model
DEFAULT_AI_MODEL=gpt-4o-mini
