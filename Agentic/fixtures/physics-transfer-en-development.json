      "version": 1,
      "concept_id": "force-dev",
      "title": "Development theory: force and acceleration",
      "theory": "For constant mass, net force F = ma. Acceleration is net force divided by mass. The SI units are N for force, kg for mass, and m/s² for acceleration.",
      "url": null
    },
    {
      "id": "speed-theory-dev-v1",
      "version": 1,
      "concept_id": "speed-dev",
      "title": "Development theory: average speed",
      "theory": "Average speed is total distance divided by elapsed time. It is a scalar measured in m/s. Use distance, not displacement, for average speed.",
      "url": null
    },
    {
      "id": "wave-theory-dev-v1",
      "version": 1,
      "concept_id": "wave-speed-dev",
      "title": "Development theory: wave equation",
      "theory": "Wave speed v = fλ, where f is frequency in Hz and λ is wavelength in metres. Multiplying Hz by metres gives m/s.",
      "url": null
    }
