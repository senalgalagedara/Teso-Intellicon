# Python settings: copy/merge into Agentic/.env. Real environment files are ignored.
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./teso-dev.db
# Neon: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ASSESSMENT_BRIDGE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOW_DEVELOPMENT_CONTENT=true
AI_PROVIDER=mock
# For live generation set AI_PROVIDER=aimlapi and the server-only key below.
AI_API_KEY=
AI_BASE_URL=https://api.aimlapi.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_ENABLED=true
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_RETRIES=3
JOB_LEASE_SECONDS=180
# Supabase private assessment storage; separate from template public app-storage.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=
ASSESSMENT_STORAGE_BUCKET=teso-assessments
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_PIXELS=20000000
# Hosting: set ENVIRONMENT=production, ALLOW_DEVELOPMENT_CONTENT=false,
# AI_PROVIDER=aimlapi and DATABASE_URL to Neon PostgreSQL.
